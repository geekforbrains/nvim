-- Bootstrap lazy.nvim
local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
if not (vim.uv or vim.loop).fs_stat(lazypath) then
  local lazyrepo = "https://github.com/folke/lazy.nvim.git"
  local out = vim.fn.system({ "git", "clone", "--filter=blob:none", "--branch=stable", lazyrepo, lazypath })
  if vim.v.shell_error ~= 0 then
    vim.api.nvim_echo({
      { "Failed to clone lazy.nvim:\n", "ErrorMsg" },
      { out, "WarningMsg" },
      { "\nPress any key to exit..." },
    }, true, {})
    vim.fn.getchar()
    os.exit(1)
  end
end
vim.opt.rtp:prepend(lazypath)


-- Make sure to setup `mapleader` and `maplocalleader` before
-- loading lazy.nvim so that mappings are correct.
-- This is also a good place to setup other settings (vim.opt)
vim.g.mapleader = " "
vim.g.maplocalleader = "\\"
vim.g.loaded_netrw = 1
vim.g.loaded_netrwPlugin = 1

vim.opt.termguicolors = true
vim.opt.clipboard = "unnamedplus"
vim.opt.number = true
vim.opt.cursorline = true
vim.opt.undofile = true
vim.opt.undodir = vim.fn.stdpath("data") .. "/undo"
vim.opt.splitbelow = true
vim.opt.splitright = true

vim.keymap.set("n", "<leader>e", ":NvimTreeToggle<CR>", { silent = true })
vim.keymap.set("n", "<C-h>", "<C-w>h", { silent = true })
vim.keymap.set("n", "<C-j>", "<C-w>j", { silent = true })
vim.keymap.set("n", "<C-k>", "<C-w>k", { silent = true })
vim.keymap.set("n", "<C-l>", "<C-w>l", { silent = true })


-- Setup lazy.nvim
require("lazy").setup({
  spec = {
    { "shaunsingh/nord.nvim" },
    { "nvim-tree/nvim-tree.lua" },
    { "nvim-telescope/telescope.nvim", dependencies = { "nvim-lua/plenary.nvim" } },
    { "github/copilot.vim" },
    { "neovim/nvim-lspconfig" },
    { "williamboman/mason.nvim" },
    { "williamboman/mason-lspconfig.nvim" },
  },
  -- Configure any other settings here. See the documentation for more details.
  -- colorscheme that will be used when installing plugins.
  install = { colorscheme = { "nord" } },
  -- automatically check for plugin updates
  checker = { enabled = true },
})


-- Setup nvim-tree
require("nvim-tree").setup({
  on_attach = function(bufnr)
    local api = require('nvim-tree.api')
    local opts = { buffer = bufnr, noremap = true, silent = true, nowait = true }

    -- Map "Enter" to open the file in the main window
    vim.keymap.set('n', '<CR>', api.node.open.edit, opts)

    -- Custom key mapping to open files in a horizontal split with "i"
    vim.keymap.set('n', 'i', api.node.open.horizontal, opts)
    vim.keymap.set('n', 's', api.node.open.vertical, opts)
  end,
  sort = {
    sorter = "case_sensitive",
  },
  view = {
    width = 24,
  },
  renderer = {
    group_empty = true,
  },
  filters = {
    dotfiles = true,
  },
})


vim.cmd("colorscheme nord")

local telescope = require("telescope.builtin")

-- Find files
vim.keymap.set("n", "<leader>ff", telescope.find_files, { noremap = true, silent = true })

-- Search for words (grep)
vim.keymap.set("n", "<leader>fw", telescope.live_grep, { noremap = true, silent = true })

vim.keymap.set("n", "<leader>,", ":noh<CR>", { noremap = true, silent = true })

-- Default indentation (2 spaces)
vim.opt.expandtab = true
vim.opt.shiftwidth = 2
vim.opt.tabstop = 2
vim.opt.softtabstop = 2

-- Python-specific indentation (4 spaces)
vim.api.nvim_create_autocmd("FileType", {
  pattern = "python",
  callback = function()
    vim.opt_local.shiftwidth = 4
    vim.opt_local.tabstop = 4
    vim.opt_local.softtabstop = 4
  end,
})

vim.opt.fillchars = { vert = " ", horiz = " ", eob = " " }

require("mason").setup()
require("mason-lspconfig").setup({
  ensure_installed = { "pylsp" },
})

local lspconfig = require("lspconfig")

lspconfig.pylsp.setup({
  settings = {
    pylsp = {
      plugins = {
        flake8 = { enabled = true },
        pycodestyle = { enabled = false },
        mccabe = { enabled = false },
        pyflakes = { enabled = false },
      },
    },
  },
  on_attach = function(client, bufnr)
    -- Key mappings for navigation
    local opts = { noremap = true, silent = true, buffer = bufnr }
    vim.keymap.set("n", "gd", vim.lsp.buf.definition, opts)      -- Go to definition
    vim.keymap.set("n", "gr", vim.lsp.buf.references, opts)      -- Show references
  end,
})
